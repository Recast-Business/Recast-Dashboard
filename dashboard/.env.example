VITE_SUPABASE_URL=https://meobtbqoklldvloqichy.supabase.co
VITE_SUPABASE_ANON_KEY=paste_anon_key_here
VITE_SCOUT_SERVER_URL=http://localhost:7433
VITE_SENTRY_DSN=
# Web Push (Round 4) — public half of the VAPID keypair. Safe to be
# public (that's the point of "public key"); the private half lives
# only in the send-push Edge Function's secrets, never here.
VITE_VAPID_PUBLIC_KEY=

# Roster source spreadsheet (Google Sheets). Optional: unset uses the original
# sheet. Take both values from the sheet URL:
#   docs.google.com/spreadsheets/d/<ROSTER_SPREADSHEET_ID>/edit#gid=<ROSTER_SHEET_GID>
# The sheet must be shared with the service account's client_email from
# GOOGLE_CREDENTIALS_JSON, otherwise reads fail with a permission error.
ROSTER_SPREADSHEET_ID=
ROSTER_SHEET_GID=
